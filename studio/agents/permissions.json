{
  "_about": "AI 세션의 권한 템플릿(한 벌). workspace = 작업 공간 .claude/settings.json 에 합쳐 두는 것(수동 Claude 세션용 - 사람이 승인 창에서 판단할 수 있으므로 쓰기 범위만 이 폴더로 좁히고 파괴적 명령만 막는다). web = 웹 세션(claude -p --restricted --settings …)에만 더하는 것(답할 사람이 없으므로 넓게 막는다). retired = 예전 템플릿이 넣었다가 물린 항목 - 합칠 때 작업 공간 파일에서 뺀다. 규칙 평가는 deny → ask → allow 순(첫 일치). 경로 패턴은 cwd(작업 공간) 기준. docs/dev/web-session-design.md 5절",
  "workspace": {
    "permissions": {
      "allow": [
        "Read(./**)", "Edit(./**)", "Write(./**)", "Glob", "Grep",
        "Bash(python3 nexa.py *)", "Bash(python nexa.py *)",
        "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)"
      ],
      "deny": [
        "Bash(rm *)", "Bash(del *)", "Bash(rmdir *)"
      ]
    }
  },
  "web": {
    "permissions": {
      "deny": [
        "mcp__*", "PowerShell", "WebFetch", "WebSearch",
        "Bash(curl *)", "Bash(wget *)", "Bash(powershell *)", "Bash(pwsh *)", "Bash(cmd *)"
      ],
      "blockReadsOutsideWorkingDirectories": true
    }
  },
  "engine": {
    "_about": "엔진 개발 웹 세션(허브가 엔진 worktree 를 cwd 로 띄움 - docs/dev/engine-request-design.md 6절). web 묶음의 deny 가 더해진다",
    "permissions": {
      "allow": [
        "Read(./**)", "Edit(./**)", "Write(./**)", "Glob", "Grep",
        "Bash(python3 studio/*)", "Bash(python studio/*)", "Bash(python3 -m py_compile *)", "Bash(python -m py_compile *)",
        "Bash(python3 .nexa/*)", "Bash(python .nexa/*)",
        "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show *)", "Bash(git branch*)", "Bash(git rev-parse *)",
        "Bash(git add *)", "Bash(git commit *)"
      ],
      "deny": [
        "Bash(git push*)", "Bash(git merge*)", "Bash(git rebase*)", "Bash(git reset*)", "Bash(git checkout *)", "Bash(git switch *)", "Bash(git worktree *)",
        "Bash(git clean*)", "Bash(git stash*)",
        "Bash(python3 studio/service.py *)", "Bash(python studio/service.py *)", "Bash(python3 studio/server.py *)", "Bash(python studio/server.py *)",
        "Bash(python3 studio/auth.py *)", "Bash(python studio/auth.py *)",
        "Bash(rm *)", "Bash(del *)", "Bash(rmdir *)"
      ]
    }
  },
  "retired": {
    "allow": ["Read", "Edit", "Write"],
    "deny": ["PowerShell", "WebFetch", "WebSearch", "Bash(curl *)", "Bash(wget *)", "Bash(powershell *)", "Bash(pwsh *)", "Bash(cmd *)"]
  }
}
